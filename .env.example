# Generated by scripts/generate_env_example.py from src/config/env_contract.py.
# Do not hand-edit; update ENV_SCHEMA and regenerate.

# === Storage ===
# Optional. Model artifact directory override; local execution defaults to src/ml/models.
MODELS_DIR=
# Required for: api, scheduler. HMAC key for serialized artifacts; use at least 32 random bytes.
ARTIFACT_SIGNING_KEY=
# Optional. Artifact TCP connect timeout.
ARTIFACT_CONNECT_TIMEOUT_SECONDS=10
# Optional. Artifact total transfer deadline.
ARTIFACT_TRANSFER_TIMEOUT_SECONDS=120
# Optional. Bundled manifest source path.
MANIFEST_SRC=/app/src/ml/models/manifest.json
# Optional. Base URL for release artifacts.
MODEL_RELEASE_BASE_URL=https://github.com/kamoheloPapola/betting-partner-system/releases/download/v1.0-models

# === Authentication ===
# Required for: api. JSON object mapping CLI admin tokens to roles.
CLI_AUTH_TOKENS=

# === Data providers ===
# Required for: api, data-fetch. football-data.org v4 API token.
FOOTBALL_DATA_API_KEY=
# Required for: enrichment. Direct API-Sports/API-Football token.
API_FOOTBALL_KEY=
# Required for: api. The Odds API token used for upcoming fixtures and odds.
ODDS_API_KEY=
# Optional. Optional OpenWeather token.
OPENWEATHER_API_KEY=
# Optional. Optional season-year override.
FOOTBALL_DATA_SEASON=

# === Observability ===
# Required for: api, scheduler. Sentry project DSN.
SENTRY_DSN=
# Optional. Sentry trace sample rate.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Optional. Release/version tag sent to telemetry.
APP_VERSION=

# === Runtime ===
# Optional. Runtime environment name.
ENV=development
# Optional. Application log level.
LOG_LEVEL=INFO
# Optional. Optional CLI log-file override.
PREDICTION_SYSTEM_LOG_FILE=

# === Runtime flags ===
# Optional. Enable API prediction-cache warmup.
WARMUP_CACHE=false
# Optional. Development-only API lock bypass.
SKIP_MODEL_LOCK_CHECK=false
# Optional. Optional joblib worker CPU limit.
LOKY_MAX_CPU_COUNT=

# === Model tuning ===
# Optional. LightGBM ensemble weight.
SPECIALIST_ENSEMBLE_LGBM_WEIGHT=0.6
# Optional. XGBoost ensemble weight.
SPECIALIST_ENSEMBLE_XGB_WEIGHT=0.4
# Optional. Maximum ensemble disagreement before gating.
SPECIALIST_ENSEMBLE_DIVERGENCE_THRESHOLD=0.20

# === Artifact sync ===
# Optional. Optional S3 access key.
AWS_ACCESS_KEY_ID=
# Optional. Optional S3 secret key.
AWS_SECRET_ACCESS_KEY=
# Optional. Optional S3 region.
AWS_REGION=
# Optional. Optional model-sync bucket.
S3_BUCKET=
# Optional. Optional model-sync key prefix.
S3_PREFIX=

# === Alert channels ===
# Optional. Optional Slack webhook.
SLACK_WEBHOOK_URL=
# Optional. Optional ntfy topic.
NTFY_TOPIC=
# Optional. Optional alert recipient.
ALERT_EMAIL_TO=
# Optional. Alert sender address.
ALERT_EMAIL_FROM=betting-system@localhost
# Optional. SMTP server hostname.
SMTP_HOST=localhost
# Optional. SMTP server port.
SMTP_PORT=25
# Optional. Maximum age of the nightly success heartbeat before alerting.
NIGHTLY_HEARTBEAT_MAX_AGE_HOURS=30

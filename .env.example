# === Model Storage ===
# Directory where trained model artifacts (.pkl/.joblib) and manifest.json are stored.
# Defaults to src/ml/models/ if not set.
# Override to a dedicated volume in production (e.g. /mnt/models or D:/models).
# MODELS_DIR=C:/your/path/to/models

RAPIDAPI_KEY=your_rapidapi_key_here
ODDS_API_KEY=your_odds_api_key_here
OPENWEATHER_API_KEY=your_openweather_key_here
FOOTBALL_DATA_API_KEY=your_football_data_key_here
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=INFO
DATABASE_URL=postgresql://football:football_dev@localhost:5432/football_intelligence
